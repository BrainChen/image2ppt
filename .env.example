# VLM model: used by Layout Parser and OCR. Must support image input.
VLM_MODEL_NAME=qwen2.5-vl-72b-instruct
VLM_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL_API_KEY=replace-with-your-vlm-api-key

# Reasoning model: used by AST Refiner. Text-only; image support is not required.
# If REASONING_MODEL_NAME is set, pipeline enables reasoning refinement automatically.
REASONING_MODEL_NAME=qwen3-235b-a22b
REASONING_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_MODEL_API_KEY=replace-with-your-reasoning-api-key

# OCR is an enhancement step because Layout Parser already extracts text.
# continue: keep using layout text if OCR API fails. fail: stop conversion.
OCR_FAILURE_MODE=continue

# System logs. API keys and image base64 are never logged.
LOG_LEVEL=INFO
LOG_FILE=outputs/logs/img2ppt.log
